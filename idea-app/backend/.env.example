# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://dianzi:dianzi_dev_pwd@localhost:5432/dianzi_app
# SQLite 兜底（无 PG 时使用，开发用）
DATABASE_URL_FALLBACK=sqlite+aiosqlite:///./dianzi_dev.db

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== DeepSeek ==========
# 留空则自动启用 Mock 模式（不调用真实 API，返回预设创意方案）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========== JWT ==========
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ========== 应用 ==========
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ========== 业务参数 ==========
SPARK_DURATION_SECONDS=180
FADE_FADING_DAYS=7
FADE_FADED_DAYS=8
IDEA_MAX_LENGTH=300
