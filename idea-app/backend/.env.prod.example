# ============================================================
# 点子 App 生产环境配置模板
# 使用方法：复制此文件为 .env.prod，替换所有 <占位符> 为真实值
# 注意：.env.prod 已被 .gitignore 排除，不会被提交到 Git
# ============================================================

APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== JWT 密钥（生成：openssl rand -hex 32）=====
JWT_SECRET=<生成64位随机串>
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ===== 数据库密码 =====
PG_PASSWORD=<你的PG密码>
REDIS_PASSWORD=<你的Redis密码>

# ===== 容器内网访问（用容器名 postgres/redis，不是 localhost）=====
DATABASE_URL=postgresql+asyncpg://dianzi:<PG_PASSWORD>@postgres:5432/dianzi_app
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=<你的DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== CORS 配置（HTTPS 部署后改为正式域名）=====
CORS_ORIGINS=https://your-domain.com

# ===== 业务参数 =====
SPARK_DURATION_SECONDS=180
FADE_FADING_DAYS=7
FADE_FADED_DAYS=8
IDEA_MAX_LENGTH=300

# ===== Moderation admin allowlist =====
# Comma-separated account UUIDs; never configure usernames or expose this value to clients.
ADMIN_USER_IDS=<管理员用户UUID列表，逗号分隔>

# ===== Scheduler 配置 =====
DIANZI_SCHEDULER_ENABLED=1
